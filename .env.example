# Browser-visible application configuration only.
# Copy to .env.local and fill from the target Supabase project's public settings.
# Never place service-role keys, database passwords, access tokens, or other
# server-side secrets in VITE_* variables or commit them to the repository.

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key
